{
  "name": "@silmaril/pi-firewall-plugin",
  "version": "0.2.2",
  "description": "Silmaril Firewall lifecycle protection for Pi coding agents.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": ["pi-package", "ai-security", "firewall", "prompt-injection"],
  "homepage": "https://www.silmaril.dev/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Silmaril-Security/PiFirewallPlugin.git"
  },
  "bugs": {
    "url": "https://github.com/Silmaril-Security/PiFirewallPlugin/security"
  },
  "files": [
    "extensions",
    "src",
    "skills",
    "scripts/open-playground.mjs",
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "test": "node --import tsx --test test/*.test.ts",
    "pack:dry": "npm pack --dry-run"
  },
  "dependencies": {
    "@silmaril-security/sdk": "0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
